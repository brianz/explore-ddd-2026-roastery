python := ".venv/bin/python"
pip := ".venv/bin/pip"
# Override for a split-room run: `BUS=roastery-bus-2 just logs`.
bus := env_var_or_default("BUS", "roastery-bus")

# list available recipes
default:
    @just --list

# create the venv and install boto3 — run once
install:
    python3 -m venv .venv
    {{pip}} install -r requirements.txt

# print the shared SKU catalog
list-skus:
    {{python}} roastery_admin.py list-skus

# print the shared green-lot catalog
list-green-lots:
    {{python}} roastery_admin.py list-green-lots

# print the shared roastable catalog
list-roastables:
    {{python}} roastery_admin.py list-roastables

# publish an arbitrary event onto the shared bus, e.g.:
#   just publish SayHelloEvent '{"msg": "hi"}'
#   BUS=roastery-bus-2 just publish SayHelloEvent '{"msg": "hi"}'
publish detail-type detail='{}':
    {{python}} roastery_admin.py --bus-name {{bus}} publish --detail-type {{detail-type}} --detail '{{detail}}'

# tail every event on the shared bus — leave running in a second terminal
logs:
    aws logs tail /aws/events/{{bus}} --follow
