// ExploreDDD 2026 workshop — local Dev Container (Docker Desktop + VS Code).
//
// Every attendee runs this on their own laptop via "Dev Containers: Reopen in
// Container", which gives everyone an identical machine with Python 3.14, the
// AWS SAM CLI, `just`, the AWS CLI, and Claude Code (both the CLI and the VS Code
// extension) already installed — and Claude Code already pointed at Amazon
// Bedrock. There is nothing to log into: the same AWS credentials that run
// `sam deploy` also power inference. See docs/ATTENDEE-QUICKSTART.md for what
// an attendee actually does.
//
// This file is JSONC — comments are allowed.
{
  "name": "ExploreDDD Roastery Workshop",

  // Python 3.14 is a hard requirement (sam/ Lambdas run 3.14). The image's major
  // version line stops at 1-3.13 — Python 3.14 only exists under the newer,
  // unprefixed tag below. If this tag ever stops resolving, check
  // https://mcr.microsoft.com/v2/devcontainers/python/tags/list for the current
  // scheme rather than re-adding a `1-` (or other) version prefix blind.
  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",

  "features": {
    // Node is only here so `npm i -g @anthropic-ai/claude-code` works in postCreate.
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },

  // The workspace folder is a bind mount of the repo on disk, so anything the
  // container writes under it is also visible on the host, and vice versa. That's
  // fine for source, but sam/cli/.venv is a build artifact: if you've ever run the
  // CLI natively on your Mac (see CLAUDE.md's "Running things"), its binaries and
  // symlinks are host-native and will not resolve inside the container. This volume
  // shadows just that one directory so the container always builds its own,
  // container-native venv there — your host .venv underneath is untouched.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-sam-cli-venv,target=${containerWorkspaceFolder}/sam/cli/.venv,type=volume"
  ],

  // Bedrock routing that is always correct regardless of who deploys. The secret
  // values themselves are never written here — `${localEnv:VAR}` pulls each one from
  // the environment of whatever is resolving this file (the shell you launched VS
  // Code from). Your facilitator gives you these four values at the start of the
  // session.
  //
  // KNOWN GOTCHA: `${localEnv:VAR}` only resolves at the moment VS Code's process
  // starts — if VS Code was already running when you exported these vars, a new
  // window reuses the existing process's original (unset) environment and every
  // var below silently resolves to empty. Fully quit VS Code, re-export, then
  // relaunch from that exact shell.
  //
  // If a var is unset, `${localEnv:VAR}` resolves to an empty string rather than
  // failing — postCreate.sh warns and skips the model lock file when that happens.
  //
  // The whole workshop runs in ONE region — this must match the `region` pinned in
  // every sam/*/samconfig.toml (currently us-west-2). Change all of them together,
  // and confirm the chosen models + prompt caching are available there.
  "remoteEnv": {
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_REGION": "us-west-2",
    "AWS_DEFAULT_REGION": "us-west-2",
    "AWS_ACCESS_KEY_ID": "${localEnv:AWS_ACCESS_KEY_ID}",
    "AWS_SECRET_ACCESS_KEY": "${localEnv:AWS_SECRET_ACCESS_KEY}",
    "ANTHROPIC_MODEL": "${localEnv:ANTHROPIC_MODEL}",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "${localEnv:ANTHROPIC_DEFAULT_HAIKU_MODEL}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "ms-python.python"
      ]
    }
  },

  // A little headroom for `sam build` + an agentic session running at once.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb"
  },

  // There is no prebuild caching — this runs live on every attendee's own machine
  // the first time they build, which is why docs/ATTENDEE-QUICKSTART.md asks you
  // to build the container before arriving: doing it live eats several minutes,
  // time the 0:00–0:05 intro doesn't have room for.
  "postCreateCommand": "bash .devcontainer/postCreate.sh"
}
